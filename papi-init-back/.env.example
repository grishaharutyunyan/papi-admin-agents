##############################################################################
# papi-init-back — environment template
#
# Copy to `.env` and fill in. Every variable is validated at boot; a missing or
# malformed value kills the process before it listens, reporting ALL problems
# at once (see src/configs/env.schema.ts).
#
# Never commit a real `.env`. No secret belongs in this file.
##############################################################################

# ---------------------------------------------------------------------- core
# local | test | development | staging | production
NODE_ENV=local
PORT=7790
APP_NAME=papi-init-back

# Number of trusted reverse-proxy hops. MUST match your actual deployment: this
# is what makes the client IP trustworthy for rate limiting and for the
# X-Forwarded-For this service sets on its own calls to papi-authority
# (Part P.6). 0 = no proxy in front (use the socket address).
TRUSTED_PROXY_HOPS=0

# Comma-separated EXACT origins. Never `*`. Required in staging/production.
#
# NOTE the local-only escape hatch in main.ts: when NODE_ENV=local AND this
# list is empty, every origin is allowed, so a developer is not blocked by
# CORS before a front-end origin exists. It is gated on `isLocal`, so an empty
# list in staging/production rejects every browser origin — fail-closed.
CORS_ORIGINS=

# Grace window between /ready returning 503 and the server actually closing,
# so load balancers can drain in-flight traffic.
READINESS_DRAIN_MS=5000
BODY_LIMIT=100kb

# ------------------------------------------------------------ papi-authority
# This fork's identity in papi-authority. MUST match a seeded
# `admin_panels.panel_key` row there (Part P.7) — same format papi-authority
# enforces at panel creation (`^[A-Z0-9_]+$`, e.g. RMP, CMS, DMP).
PANEL_KEY=

# Base URL of the papi-authority instance this service is a thin consumer of.
# No trailing slash. Requires a running, seeded papi-authority instance — boot
# it per papi-authority's own CLAUDE.md/README first (Part P.7's cross-repo
# dev-bootstrap dependency).
PAPI_AUTHORITY_BASE_URL=http://localhost:7780

# --------------------------------------------------------------- token verify
# Expected `iss`/`aud` on every access token this service verifies locally
# against papi-authority's JWKS (Phase 2). MUST match the ACTUAL papi-authority
# instance's own JWT_ISSUER/JWT_AUDIENCE (its `src/configs/auth.config.ts`) —
# these are local defaults for papi-authority, not fixed platform constants, so
# do not assume they are correct without checking the instance you point at.
JWT_ISSUER=papi-authority
JWT_AUDIENCE=nrg-platform

# ------------------------------------------------------------------ throttle
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=100
# Applied per-route to login/refresh/SSO from Phase 3 — deliberately NOT a
# global bucket.
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10