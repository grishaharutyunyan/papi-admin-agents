##############################################################################
# papi-authority — environment template
#
# Copy to `.env` and fill in. Every variable is validated at boot; a missing or
# malformed value kills the process before it listens, reporting ALL problems at
# once (see src/configs/env.schema.ts).
#
# Never commit a real `.env`. No secret belongs in this file.
##############################################################################

# ---------------------------------------------------------------------- core
# local | test | development | staging | production
NODE_ENV=local
PORT=7780
APP_NAME=papi-authority

# Number of trusted reverse-proxy hops. MUST match your actual deployment: this
# is what makes the client IP trustworthy for rate limiting and the audit trail.
# 0 = no proxy in front (use the socket address).
TRUSTED_PROXY_HOPS=0

# Comma-separated EXACT origins. Never `*`. Required in staging/production.
# The forks call this service server-to-server (no Origin header), so this list
# only needs browser-facing origins — chiefly the invitation page.
#
# NOTE the local-only escape hatch in main.ts: when NODE_ENV=local AND this list
# is empty (and INVITATION_ORIGIN is unset), every origin is allowed, so a
# developer is not blocked by CORS before any origin exists. It is gated on
# `isLocal`, so an empty list in staging/production rejects every browser
# origin — fail-closed. If you are testing CORS locally, SET this list;
# otherwise you will observe "evil.com is allowed" and think it is a bug.
CORS_ORIGINS=

# Grace window between /ready returning 503 and the server actually closing,
# so load balancers can drain in-flight traffic.
READINESS_DRAIN_MS=5000
BODY_LIMIT=100kb

# ------------------------------------------------------------------ database
# Three principals, three URIs. See docker/mysql/init/01-users-and-grants.sh
# for what each one may do and why.
DB_AUTHORITY_URI=mysql://papi_authority:CHANGE_ME@127.0.0.1:3306/papi_authority
DB_CONSOLE_URI=mysql://papi_console:CHANGE_ME@127.0.0.1:3306/papi_authority

# DDL-only principal. Used by `npm run migration:*` — NOT by the running
# service. Leave unset in deployments where the DB team applies schema changes.
DB_MIGRATOR_URI=mysql://papi_migrator:CHANGE_ME@127.0.0.1:3306/papi_authority

# Required (1) in staging/production.
DB_SSL=0
DB_LOGGING=0

# ---------------------------------------------------------------------- auth
# The revocation ceiling: with no Redis, this is how long a revoked user can
# still act. Max 900 (15 min).
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=604800

JWT_ISSUER=papi-authority
JWT_AUDIENCE=nrg-platform

# invite_only | open_sso
ONBOARDING_MODE=invite_only

# Origin of the standalone invitation/join page (its own subdomain, built
# separately). Added to the CORS allow-list automatically when set.
INVITATION_ORIGIN=
INVITATION_TTL_HOURS=72

# ------------------------------------------------------------------- lockout
# Account lockout after repeated password failures.
LOCKOUT_MAX_FAILURES=10
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=30

# -------------------------------------------------------------------- crypto
# azure_key_vault | dev_local
# `dev_local` is FORBIDDEN in staging/production — boot fails if you try, in
# three independent places (config validation, the module factory, and the
# provider's own constructor).
KEY_SOURCE=dev_local

# Azure Key Vault. The private key NEVER leaves the vault: papi-authority sends
# a SHA-256 digest and Key Vault performs the RSA operation internally.
#
# Required setup, for when real values exist:
#   - An RSA key (2048+ or RSA-HSM) in the vault. NOT a secret — a KEY.
#   - Authentication is DefaultAzureCredential: use a managed identity in
#     Azure. Do NOT configure a client secret.
#   - Grant that identity exactly two key permissions: `get` and `sign`.
#     It must NOT have `export`, `decrypt`, `unwrapKey`, `update`, or `delete`.
#   - `get` is needed only to read the PUBLIC half for the JWKS endpoint.
AZURE_KEYVAULT_URI=
AZURE_KEYVAULT_KEY_NAME=

# Local development only. If set, the dev key is persisted here (mode 0600) so
# `kid` stays stable across restarts; if unset, an ephemeral key is generated
# and tokens do not survive a restart. Never commit this file.
DEV_LOCAL_KEY_PATH=

# ---------------------------------------------------------------------- mail
# Azure Communication Services. Wired in Phase 6.
MAIL_ENABLED=0
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# --------------------------------------------------------------------- audit
# Geo-IP enrichment for the audit trail (dossier 0.53).
#
# LOCAL MaxMind databases only — there is no provider URL and no API key by
# design: enrichment must not put a third-party network call on the login path
# or disclose administrator IPs to an outside service.
#
# GeoLite2 files are licence-gated and are NOT in this repository. Obtain them
# from MaxMind and have the ops team place them on the host; until then leave
# GEOIP_ENABLED=0 and the geo columns stay NULL.
GEOIP_ENABLED=0
GEOIP_CITY_DB=
GEOIP_ASN_DB=

# ------------------------------------------------------------------ throttle
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=100
# Applied per-route to login/refresh/SSO/invitation from Phase 4 — deliberately
# NOT a global bucket.
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10

##############################################################################
# docker-compose only (local development)
##############################################################################
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=papi_authority
MYSQL_PORT=3306
PAPI_MIGRATOR_PASSWORD=
PAPI_AUTHORITY_PASSWORD=
PAPI_CONSOLE_PASSWORD=
